# Youga App — variáveis de ambiente
# Copie para .env.local e preencha. .env.local é ignorado pelo git.

# --- Front-end (Vite) ---
# Chaves PÚBLICAS: vão para o bundle do navegador. Seguras porque o acesso
# aos dados é controlado por Row Level Security (RLS) no Supabase.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxx

# --- Somente CLI/local (NUNCA vai para o front) ---
# Senha do banco, usada por `supabase db push`. Vite não expõe (sem prefixo VITE_).
# SUPABASE_DB_PASSWORD='sua-senha-do-banco'
